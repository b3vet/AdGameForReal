<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Generated by `npx cap add ios` and then edited by hand for Milestone 9
	(docs/25-milestone-9-plan.md, section C). Every key that differs from the
	Capacitor template carries the reason next to it; docs/DEVICE.md section 8
	is the same table in prose.

	Xcode's plist editor drops XML comments when it rewrites the file, so if the
	comments are gone one day, that is what happened — the reasons live in
	docs/DEVICE.md as well for exactly that reason.
-->
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- The name under the icon on the home screen. From `appName` in capacitor.config.ts. -->
	<key>CFBundleDisplayName</key>
	<string>Arcane Rush</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!--
		Both version numbers come from package.json through
		`npm run cap:version` (scripts/cap-version.mjs), which writes
		MARKETING_VERSION and CURRENT_PROJECT_VERSION into the Xcode project.
		Nothing here is ever edited by hand.
	-->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
		Export compliance. The game uses no encryption of its own and makes no
		network calls at all; everything it reads is in the app bundle. Declaring
		this here is what stops App Store Connect asking the question on every
		single upload (docs/STORE.md, "Export compliance").
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!--
		The Capacitor template still asks for `armv7`, which was 32-bit and has
		not shipped on a device that runs iOS 11, let alone our iOS 15 floor.
		`arm64` is the honest requirement.
	-->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!--
		The game owns the whole screen: no Slide Over, no Split View, no
		Stage Manager window that would hand it an arbitrary aspect ratio the
		portrait layout has never been designed for.
	-->
	<key>UIRequiresFullScreen</key>
	<true/>
	<!--
		Read by Capacitor's CAPBridgeViewController for `prefersStatusBarHidden`,
		so the status bar is gone from the first frame rather than from whenever
		`src/device/shell.ts`'s StatusBar.hide() crosses the bridge. Without it
		the bar is visible over the launch splash and for the first moment of the
		game, right where the level chip and the squad count sit.
	-->
	<key>UIStatusBarHidden</key>
	<true/>
	<!--
		Portrait only. The road, the camera and every HUD plaque are built for one
		orientation; `@capacitor/screen-orientation` locks it at boot as well
		(src/device), and this is the half of the lock the system enforces before
		any JavaScript runs.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
		TARGETED_DEVICE_FAMILY is 1 (iPhone) in the Xcode project, so this key is
		only ever read when an iPad runs the app in iPhone compatibility mode.
		Kept portrait for the same reason as above.
	-->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<!--
		Must stay YES: @capacitor/status-bar drives the bar through the view
		controller, and the plugin does nothing at all if this is NO.
	-->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
