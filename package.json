{
  "name": "arcane-rush",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Portrait lane-defense auto-shooter (Babylon.js).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "cap:preflight": "node scripts/cap-preflight.mjs",
    "cap:assets": "npx @capacitor/assets generate --ios --android --assetPath assets/app --iconBackgroundColor '#3b2a7a' --iconBackgroundColorDark '#3b2a7a' --splashBackgroundColor '#bfe4f5' --splashBackgroundColorDark '#bfe4f5'",
    "cap:version": "node scripts/cap-version.mjs",
    "cap:sync": "npm run build && npm run cap:version && npx cap sync ios",
    "cap:sync:android": "npm run build && npm run cap:version && npx cap sync android",
    "cap:open": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@babylonjs/core": "9.25.0",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.25.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/screen-orientation": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0"
  }
}
